# Local runs: copy to prod.tfvars (git-ignored). CI passes the same values as
# TF_VAR_* environment variables from GitHub repository variables.

project_id               = "your-project-id"
domain                   = "example.com"
alert_emails             = ["alerts@example.com"]
deployer_service_account = "gh-app-deploy@your-project-id.iam.gserviceaccount.com"

# Optional overrides
# region                    = "us-central1"
# zone                      = "us-central1-a"
# allowed_countries         = ["ES", "AM"]
# cloudflare_paid_waf       = false
# cloudflare_bot_fight_mode = false

# cloudflare_api_token: set TF_VAR_cloudflare_api_token instead of writing it here
