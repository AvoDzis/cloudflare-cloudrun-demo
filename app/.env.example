# Copy to .env for local runs: npm run dev  (node --env-file=.env server.js)
# On Cloud Run these are set by terraform/modules/cloud-run; DB_PASSWORD and
# CLOUDFLARE_SECRET come from Secret Manager.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=labdb
DB_USER=labuser
DB_PASSWORD=change-me
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
# Leave empty locally. When set, every route except /health and /livez needs
# a matching X-Cloudflare-Secret request header.
CLOUDFLARE_SECRET=
